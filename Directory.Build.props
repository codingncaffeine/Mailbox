<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!--
      On, and auditing transitive packages too. A mail client is the wrong place to be quiet
      about a known-vulnerable dependency, and with TreatWarningsAsErrors this is a build gate
      rather than a note nobody reads. See §19.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Mailbox</Product>
    <Company>Mailbox</Company>
    <Authors>codingncaffeine</Authors>
    <Copyright>Copyright (C) 2026 Mailbox contributors</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <!-- Central package versions. Bump here, nowhere else. -->
  <PropertyGroup>
    <AvaloniaVersion>12.1.1</AvaloniaVersion>
    <MailKitVersion>4.17.0</MailKitVersion>
    <SqliteVersion>10.0.11</SqliteVersion>
  </PropertyGroup>

</Project>
