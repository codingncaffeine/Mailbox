<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!--
      On, and auditing transitive packages too. A mail client is the wrong place to be quiet
      about a known-vulnerable dependency, and with TreatWarningsAsErrors this is a build gate
      rather than a note nobody reads. See §19.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Mailbox</Product>
    <Company>Mailbox</Company>
    <Authors>codingncaffeine</Authors>
    <Copyright>Copyright (C) 2026 Mailbox contributors</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <VersionPrefix>0.0.5</VersionPrefix>
  </PropertyGroup>

  <!--
    Central package versions. Bump here, nowhere else — a version written on a
    PackageReference is one this file cannot see, and two copies of a number drift the day
    only one of them is bumped.
  -->
  <PropertyGroup>
    <AvaloniaVersion>12.1.1</AvaloniaVersion>
    <!-- Its own release train, not Avalonia's: the WebView package is versioned separately.
         12.1.0 (2026-08-15, MIT now) carries the WPE script-callback fix the paint nudge
         leans on; the nudge itself stays, because the offscreen export path it covers is
         unchanged upstream and that release's "first paint" fix is GTK-only. -->
    <AvaloniaWebViewVersion>12.1.0</AvaloniaWebViewVersion>
    <MailKitVersion>4.17.0</MailKitVersion>
    <SqliteVersion>10.0.11</SqliteVersion>
    <IcalNetVersion>5.2.3</IcalNetVersion>
    <VCardsVersion>8.1.2</VCardsVersion>
    <RichEditorVersion>1.1.0</RichEditorVersion>
    <HunspellVersion>7.0.1</HunspellVersion>
    <!-- Mailbox.Security compiles against Org.BouncyCastle directly — S/MIME, OpenPGP, DKIM
         and the passphrase vault all name its types. It used to arrive only as MimeKit's own
         dependency, which meant its version was whatever MimeKit happened to resolve and a
         MimeKit bump that dropped or majored it would have broken the build with nothing here
         to say why. 2.6.2 is what MimeKit 4.17.0 resolves today, so pinning it changes no
         binary; it only makes the dependency one we chose rather than one we inherited. -->
    <BouncyCastleVersion>2.6.2</BouncyCastleVersion>
  </PropertyGroup>

  <!-- The test project's own, kept here for the same reason. -->
  <PropertyGroup>
    <TestSdkVersion>17.14.1</TestSdkVersion>
    <XunitVersion>3.1.0</XunitVersion>
    <XunitRunnerVersion>3.1.4</XunitRunnerVersion>
  </PropertyGroup>

</Project>
