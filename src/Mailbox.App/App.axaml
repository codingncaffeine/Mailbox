<!-- Name is what assistive technology lists the application as: the accessibility bus
     takes it for the tree's root, and without it a screen reader announces the toolkit's
     own placeholder rather than the program the user launched. -->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mailbox.App.App"
             Name="Mailbox"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <!--
            Deliberately no FluentTheme: its WinUI look would fight the clone at every
            control. SimpleTheme is here for structure only — it supplies the control
            templates that ListBox, ComboBox, ScrollViewer and GridSplitter need in order to
            render at all. It contributes no colour; Shell.axaml paints everything from
            tokens. It is a scaffold: control themes of our own replace it template by template.
        -->
        <SimpleTheme />

        <!-- Relative rather than avares:// so it survives the assembly being named
             'mailbox' for the Linux binary. -->
        <StyleInclude Source="/Styles/Shell.axaml" />

        <!-- After Shell.axaml on purpose: a system dialog's rules override the general ones. -->
        <StyleInclude Source="/Styles/SystemDialog.axaml" />
    </Application.Styles>

</Application>
