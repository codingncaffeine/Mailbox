<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Mailbox.App.ViewModels"
        xmlns:views="using:Mailbox.App.Views"
        xmlns:theming="using:Mailbox.App.Theming"
        mc:Ignorable="d"
        x:Class="Mailbox.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Mailbox"
        Width="1280" Height="820"
        MinWidth="760" MinHeight="480"
        Background="Transparent"
        TransparencyLevelHint="Transparent,None"
        FontFamily="{DynamicResource ui.fontfamily}"
        Icon="/Assets/Icons/mailbox-256.png"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None">

    <!--
        Rounded window. The reference rounds its outer corners at the same radius as the panels
        inside it, so the window is transparent and this border draws the shape. Clipping is
        what keeps the corners honest: without it a child painting into them shows as a wedge,
        which is the same failure the workspace's corners had.
    -->
    <Border CornerRadius="8"
            ClipToBounds="True"
            Background="{DynamicResource ribbon.tabstrip.background.brush}">
    <Grid RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="Auto,*">
        <Grid.Resources>
            <theming:TokenBrushConverter x:Key="TokenBrush" />
        </Grid.Resources>

        <!--
            Chrome backdrop, behind everything. The title bar and the tab strip are one
            continuous surface in the reference application, and painting them as one also
            closes the sub-pixel seam between grid rows that otherwise let the window
            background through as a pale hairline.

            It spans every row because the panels above it are rounded: their corners, and the
            gap between the ribbon and the workspace, have to reveal chrome. Stopping at the
            ribbon left the window's own background showing through as pale wedges.

            It paints the tab strip's colour rather than the title bar's. The two are within a
            shade of each other in Dark Gray, which hid the distinction, but in Colorful the
            title bar is brand blue and the surface behind the panels is not — using the title
            bar's colour ran a blue strip through the gap.
        -->
        <Border Grid.Row="0" Grid.RowSpan="4" Grid.ColumnSpan="2"
                ZIndex="0"
                Background="{DynamicResource ribbon.tabstrip.background.brush}" />

        <!-- ============================ Title bar ============================ -->
        <!--
            Client-side decorated: the window draws its own caption so there is exactly one
            title bar. Left to the compositor there would be two — KDE's dark one stacked on
            the reference's coloured one — which is the mismatch that looked wrong.
            App icon, then the Quick Access Toolbar, title centred, caption buttons right.
        -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Name="TitleBar"
                Background="{DynamicResource titlebar.background.brush}"
                Height="{DynamicResource titlebar.height.value}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                <!-- The app icon carries the window menu, which the window itself must now
                     provide: it is drawn without a system frame. -->
                <Button Grid.Column="0"
                        Name="WindowMenuButton"
                        Padding="0"
                        Margin="17,0,6,0"
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalAlignment="Center">
                    <Image Source="/Assets/Icons/mailbox-32.png" Width="16" Height="16" />
                </Button>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsQuickAccessAbove}">
                <ItemsControl Name="QuickAccessBar"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding QuickAccess}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:QuickAccessButton">
                            <Panel>
                                <!-- A toolbar may carry rules as well as commands. -->
                                <Border Width="1"
                                        Height="14"
                                        Margin="4,0"
                                        Opacity="0.4"
                                        IsVisible="{Binding IsSeparator}"
                                        Background="{DynamicResource titlebar.foreground.brush}" />
                                <Button Padding="4,2"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        IsVisible="{Binding !IsSeparator}"
                                        Command="{Binding Invoke}"
                                        ToolTip.Tip="{Binding Tip}">
                                    <TextBlock Text="{Binding Glyph}"
                                               FontFamily="{Binding IconFamily}"
                                               FontSize="14"
                                               Foreground="{DynamicResource titlebar.foreground.brush}" />
                                </Button>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                    <!-- Customize Quick Access Toolbar. Always last, never rearrangeable. -->
                    <Button Name="QuickAccessCustomize"
                            Padding="4,2"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip.Tip="Customize Quick Access Toolbar">
                        <TextBlock Text="{Binding CustomizeGlyph}"
                                   FontFamily="{Binding IconFamily}"
                                   FontSize="11"
                                   Foreground="{DynamicResource titlebar.foreground.brush}" />
                    </Button>
                </StackPanel>

                <!--
                    Search is neither centred nor stretched. Its left edge lines up with the
                    start of the message list — the app rail plus the folder pane — and its
                    width is fixed, both confirmed against captures at two window widths.
                    It spans the columns rather than sitting in one so that position is
                    absolute and does not drift as the Quick Access Toolbar gains buttons.
                -->
                <Border Grid.Column="0" Grid.ColumnSpan="6"
                        IsVisible="{Binding ShowHeaderSearch}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="{DynamicResource titlebar.search.offset.leftmargin}"
                        Width="{DynamicResource titlebar.search.width.value}"
                        Height="{DynamicResource titlebar.search.height.value}"
                        CornerRadius="4"
                        BorderThickness="1"
                        Background="{DynamicResource titlebar.search.brush}"
                        BorderBrush="{DynamicResource titlebar.search.border.brush}">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SearchGlyph}"
                                   FontFamily="{Binding IconFamily}"
                                   FontSize="16"
                                   Margin="20,0,16,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource titlebar.search.text.brush}" />
                        <Panel Grid.Column="1">
                            <TextBlock Text="{Binding SearchPlaceholder}"
                                       IsVisible="{Binding ShowSearchPlaceholder}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource titlebar.search.text.brush}"
                                       FontSize="{DynamicResource type.ui.size.value}" />
                            <TextBox Text="{Binding SearchText}"
                                     Classes="titlebar-search"
                                     VerticalAlignment="Center"
                                     Padding="0"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource titlebar.search.text.brush}"
                                     FontSize="{DynamicResource type.ui.size.value}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                        </Panel>
                    </Grid>
                </Border>

                <!--
                    Account button, left of the caption buttons. A button, not an ornament: it
                    opens the account panel. The circle is 24px inside a 50x48 hit box, both
                    measured, and the letter is the first character of the address.
                -->
                <Button Grid.Column="3"
                        Name="AccountButton"
                        Width="50" Height="48"
                        Padding="0"
                        Classes="account"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        ToolTip.Tip="{Binding AccountTip}">
                    <Border Width="24" Height="24"
                            CornerRadius="12"
                            Background="{DynamicResource avatar.background.brush}">
                        <TextBlock Text="{Binding AccountInitial}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource avatar.foreground.brush}" />
                    </Border>
                </Button>

                <!-- Windows-style caption buttons, added in code. -->
                <ContentControl Grid.Column="5" Name="CaptionHost" />
            </Grid>
        </Border>

        <!-- ====================== Ribbon / command bar ======================= -->
        <!-- Classic: the full ribbon, built by RibbonView from the layout document.
             Modern: a single-row command bar, which is what replaced the ribbon. -->
        <!--
            The ribbon floats above the workspace and casts a shadow onto it — measured at
            roughly 7px in the reference, darkest right under the bar. ZIndex lifts it over
            the panes so the shadow is not clipped by the row below.
        -->
        <Border Grid.Row="1" Grid.Column="1"
                ZIndex="2"
                IsVisible="{Binding ShowRibbon}">
            <StackPanel>
                <ContentControl Name="RibbonHost" />

                <!--
                    The Quick Access Toolbar's other home. Below the ribbon it is a strip of its
                    own rather than a run of glyphs in the title bar, so it carries labels'
                    colours from the content palette and not the title bar's.
                -->
                <Border Name="QuickAccessBelowHost"
                        IsVisible="{Binding IsQuickAccessBelow}"
                        Margin="0,0,9,6"
                        Padding="8,3"
                        CornerRadius="8"
                        Background="{DynamicResource ribbon.background.brush}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ItemsControl Name="QuickAccessBarBelow"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding QuickAccess}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:QuickAccessButton">
                                    <Panel>
                                        <Border Width="1"
                                                Height="14"
                                                Margin="4,0"
                                                Opacity="0.4"
                                                IsVisible="{Binding IsSeparator}"
                                                Background="{DynamicResource text.primary.brush}" />
                                        <Button Padding="4,2"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                IsVisible="{Binding !IsSeparator}"
                                                Command="{Binding Invoke}"
                                                ToolTip.Tip="{Binding Tip}">
                                            <TextBlock Text="{Binding Glyph}"
                                                       FontFamily="{Binding IconFamily}"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource text.primary.brush}" />
                                        </Button>
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The chevron travels with the bar; left behind, there is no way to
                             put the toolbar back where it was. -->
                        <Button Name="QuickAccessCustomizeBelow"
                                Padding="4,2"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip.Tip="Customize Quick Access Toolbar">
                            <TextBlock Text="{Binding CustomizeGlyph}"
                                       FontFamily="{Binding IconFamily}"
                                       FontSize="11"
                                       Foreground="{DynamicResource text.primary.brush}" />
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1"
                ZIndex="2"
                BoxShadow="0 4 9 -1 #73000000"
                IsVisible="{Binding ShowCommandBar}"
                Background="{DynamicResource ribbon.background.brush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource border.subtle.brush}"
                Padding="8,4">
            <ItemsControl ItemsSource="{Binding CommandBar}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:QuickAccessButton">
                        <Button Padding="8,5" Command="{Binding Invoke}" ToolTip.Tip="{Binding Tip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="{Binding IconFamily}"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource accent.rest.brush}" />
                                <TextBlock Text="{Binding Label}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- =========================== Three panes =========================== -->
        <!--
            App rail. Modern only. It begins at the tab strip rather than below the ribbon,
            which is why it lives in the outer grid spanning both rows: in the reference the
            ribbon starts to the right of the rail, not across the top of it.
        -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0"
                IsVisible="{Binding ShowAppRail}"
                Width="{DynamicResource rail.width.value}"
                Background="{DynamicResource rail.background.brush}">
            <ItemsControl ItemsSource="{Binding Modules}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModuleTab">
                        <!--
                            One 48px slot per module, the first sitting level with the tab
                            strip so the mail icon reads as being above and left of File.
                            The active module is marked by a rule against the rail's left
                            edge, measured 2x32 and set in 6px.
                        -->
                        <Grid Height="{DynamicResource rail.item.height.value}">
                            <Border Width="{DynamicResource rail.indicator.width.value}"
                                    Height="{DynamicResource rail.indicator.height.value}"
                                    Margin="{DynamicResource rail.indicator.inset.leftmargin}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsActive}"
                                    Background="{DynamicResource rail.indicator.brush}" />
                            <Button Width="40" Height="40"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Command="{Binding Activate}"
                                    Classes.active="{Binding IsActive}"
                                    ToolTip.Tip="{Binding Tip}">
                                <TextBlock Text="{Binding RailGlyph}"
                                           FontFamily="{Binding IconFamily}"
                                           FontSize="19"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource rail.item.text.brush}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Grid.Row="2" Grid.Column="1"
                Margin="{DynamicResource workspace.inset.rightmargin}"
                CornerRadius="8,8,0,0"
                ClipToBounds="True"
                Background="{DynamicResource list.background.brush}">
        <Grid Name="PaneGrid" ColumnDefinitions="Auto,Auto,1,Auto,1,*,Auto">

            <!-- Navigation pane -->
            <Border Grid.Column="1"
                    IsVisible="{Binding NavVisible}"
                    Width="{DynamicResource nav.width.value}"
                    Background="{DynamicResource nav.background.brush}">
                <DockPanel>
                    <!-- Module switcher: Ctrl+1..Ctrl+8 -->
                    <Border DockPanel.Dock="Bottom"
                            IsVisible="{Binding ShowBottomModuleStrip}"
                            Padding="6,5"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource border.subtle.brush}">
                        <ItemsControl ItemsSource="{Binding Modules}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModuleTab">
                                    <Button Padding="5,2"
                                            Classes.active="{Binding IsActive}"
                                            ToolTip.Tip="{Binding Tip}">
                                        <TextBlock Text="{Binding Glyph}"
                                                   FontFamily="{Binding IconFamily}"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource text.secondary.brush}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border DockPanel.Dock="Top" Padding="4,2">
                        <Button Classes="flat"
                                HorizontalAlignment="Right"
                                Command="{Binding ToggleNav}"
                                Content="{Binding CollapseGlyph}"
                                FontSize="12"
                                Foreground="{DynamicResource nav.item.text.brush}"
                                ToolTip.Tip="Minimize the Folder Pane" />
                    </Border>

                    <ListBox ItemsSource="{Binding Folders}"
                             Name="FolderList"
                             SelectedItem="{Binding SelectedFolder}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="8,3" />
                                <Setter Property="MinHeight" Value="22" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FolderNode">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               Margin="{Binding IndentMargin}"
                                               Foreground="{DynamicResource nav.item.text.brush}"
                                               FontWeight="{Binding Weight}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding UnreadDisplay}"
                                               Foreground="{DynamicResource nav.unreadcount.brush}"
                                               FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="2" ResizeDirection="Columns" />

            <!-- Message list -->
            <Border Grid.Column="3"
                    Width="{DynamicResource list.width.value}"
                    Background="{DynamicResource list.background.brush}">
                <DockPanel>
                    <!-- Search results header: how many, the scope, and the way out. Shown only
                         while searching, in place of the message list's ordinary top matter. -->
                    <Border DockPanel.Dock="Top"
                            IsVisible="{Binding IsSearching}"
                            Background="{DynamicResource list.header.background.brush}"
                            Padding="10,6"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource border.subtle.brush}">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding SearchResultSummary}"
                                       VerticalAlignment="Center"
                                       Classes="small"
                                       Foreground="{DynamicResource list.header.text.brush}" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding ScopeOptions}"
                                      SelectedIndex="{Binding ScopeIndex}"
                                      MinHeight="26"
                                      Margin="0,0,6,0"
                                      FontSize="{DynamicResource type.ui.size.small.value}"
                                      ToolTip.Tip="Where to search" />
                            <Button Grid.Column="2"
                                    Classes="flat"
                                    Command="{Binding ClearSearchCommand}"
                                    Content="&#x2715;"
                                    ToolTip.Tip="Clear the search (Esc)"
                                    Foreground="{DynamicResource list.header.text.brush}" />
                        </Grid>
                    </Border>

                    <!-- Search sits above the message list, where the reference application puts it.
                         Modern moves it into the header instead. -->
                    <Border DockPanel.Dock="Top"
                            IsVisible="{Binding ShowListSearch}"
                            Padding="6,5"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource border.subtle.brush}">
                        <TextBox Text="{Binding SearchText}"
                                 PlaceholderText="{Binding SearchPlaceholder}"
                                 FontSize="{DynamicResource type.ui.size.value}"
                                 Padding="6,3"
                                 MinHeight="24" />
                    </Border>

                    <!-- All / Unread pivot, with the arrangement and sort direction right. -->
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource list.header.background.brush}"
                            Padding="10,5">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                            <!-- All / Unread, or Focused / Other when Focused Inbox is on and
                                 the Inbox is open: the same two buttons, relabelled. -->
                            <Button Grid.Column="0"
                                    Classes="flat"
                                    Command="{Binding PivotLeft}"
                                    Content="{Binding PivotLeftLabel}"
                                    FontWeight="{Binding PivotLeftWeight}"
                                    Foreground="{DynamicResource list.header.text.brush}" />
                            <Button Grid.Column="1"
                                    Classes="flat"
                                    Margin="13,0,0,0"
                                    Command="{Binding PivotRight}"
                                    Content="{Binding PivotRightLabel}"
                                    FontWeight="{Binding PivotRightWeight}"
                                    Foreground="{DynamicResource list.header.text.brush}" />
                            <Button Grid.Column="3"
                                    Name="ArrangeButton"
                                    Classes="flat"
                                    Content="{Binding ArrangementLabel}"
                                    FontSize="{DynamicResource type.ui.size.small.value}"
                                    Foreground="{DynamicResource list.header.text.brush}"
                                    ToolTip.Tip="Choose how the list is arranged"
                                    VerticalAlignment="Center" />
                            <Button Grid.Column="4"
                                    Classes="flat"
                                    Margin="7,0,0,0"
                                    Command="{Binding ToggleSort}"
                                    Content="{Binding SortGlyph}"
                                    FontSize="{DynamicResource type.ui.size.small.value}"
                                    Foreground="{DynamicResource list.header.text.brush}"
                                    ToolTip.Tip="Reverse the sort order"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Column headers. the reference application shows these even in the two-line compact
                         view; the first four are icon-only glyph columns. -->
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource list.header.background.brush}"
                            BorderThickness="0,1,0,1"
                            BorderBrush="{DynamicResource border.subtle.brush}">
                        <ItemsControl ItemsSource="{Binding Columns}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MessageColumn">
                                    <Button Classes="flat"
                                            Width="{Binding Width}"
                                            Padding="4,3"
                                            HorizontalContentAlignment="Left"
                                            BorderThickness="0,0,1,0"
                                            BorderBrush="{DynamicResource border.subtle.brush}"
                                            Command="{Binding Sort}"
                                            ToolTip.Tip="{Binding SortTip}">
                                        <TextBlock Text="{Binding Title}"
                                                   Classes="small"
                                                   Foreground="{DynamicResource list.header.text.brush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!--
                        The list. Group headers and rows share one flat sequence and one
                        virtualizing panel, selected by template: nesting a panel per group
                        would cost virtualization, which is the thing that has to survive a
                        folder of a hundred thousand messages.
                    -->
                    <ListBox ItemsSource="{Binding VisibleRows}"
                             SelectedItem="{Binding SelectedRow}"
                             SelectionMode="Multiple"
                             Name="MessageList"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>

                            <!-- A row paints its own ground over the item, so the item's
                                 selection tint never showed and a selected message looked like
                                 every other one. The ground comes from a style rather than a
                                 local value, so the selected state can change it: a local value
                                 beats every style setter, which is the trap the handoff names.
                                 The tint is measured off the reference (#B3D3EC in Dark Gray),
                                 whole row, left edge included. -->
                            <Style Selector="Grid.row">
                                <Setter Property="Background" Value="{DynamicResource list.row.background.brush}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected Grid.row">
                                <Setter Property="Background" Value="{DynamicResource list.row.selected.brush}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                          <views:RowTemplateSelector>
                            <views:RowTemplateSelector.Header>
                            <!-- A group header. -->
                            <DataTemplate x:DataType="vm:GroupHeaderRow">
                                <Border Background="{DynamicResource list.group.header.background.brush}"
                                        Height="{DynamicResource list.group.header.height.value}"
                                        Padding="8,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Glyph}"
                                                   Foreground="{DynamicResource list.group.header.text.brush}" />
                                        <TextBlock Text="{Binding Header}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource list.group.header.text.brush}" />
                                        <TextBlock Text="{Binding CountLabel}"
                                                   Classes="small"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource list.group.header.text.brush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                            </views:RowTemplateSelector.Header>

                            <views:RowTemplateSelector.Conversation>
                            <!-- A folded conversation: the newest message, a count, and the
                                 marker for a thread whose messages are in more than one folder. -->
                            <DataTemplate x:DataType="vm:ConversationRow">
                                <Grid ColumnDefinitions="4,*"
                                      Classes="row"
                                      Height="{DynamicResource list.row.height.value}">
                                    <Rectangle Grid.Column="0"
                                               Fill="{DynamicResource list.row.unread.bar.brush}"
                                               IsVisible="{Binding IsUnread}" />
                                    <Grid Grid.Column="1"
                                          Margin="6,3,8,3"
                                          RowDefinitions="Auto,Auto"
                                          ColumnDefinitions="Auto,150,*,Auto,Auto,100">
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding Glyph}"
                                                   Margin="0,0,4,0"
                                                   Foreground="{DynamicResource text.secondary.brush}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding From}"
                                                   Classes.unread="{Binding IsUnread}"
                                                   FontWeight="{Binding SenderWeight}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="0" Grid.Column="2"
                                                   Text="{Binding Subject}"
                                                   Classes.unread="{Binding IsUnread}"
                                                   FontWeight="{Binding SubjectWeight}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="0" Grid.Column="3"
                                                   Text="{Binding SplitGlyph}"
                                                   Margin="0,0,6,0"
                                                   ToolTip.Tip="This conversation is filed in more than one folder"
                                                   Foreground="{DynamicResource text.secondary.brush}" />
                                        <Border Grid.Row="0" Grid.Column="4"
                                                Margin="0,0,6,0"
                                                Padding="5,0"
                                                CornerRadius="8"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource state.selected.brush}">
                                            <TextBlock Text="{Binding CountLabel}" Classes="small" />
                                        </Border>
                                        <TextBlock Grid.Row="0" Grid.Column="5"
                                                   Text="{Binding ReceivedLabel}"
                                                   Classes.unread="{Binding IsUnread}"
                                                   Classes="small"
                                                   HorizontalAlignment="Right"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   Grid.ColumnSpan="5"
                                                   Text="{Binding Preview}"
                                                   Classes="small secondary"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                            </views:RowTemplateSelector.Conversation>

                            <!-- A message. -->
                            <DataTemplate x:DataType="vm:MessageRow">
                                <Grid ColumnDefinitions="4,*"
                                      Classes="row"
                                      Height="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).RowHeight}">
                                    <!-- The unread bar. 4px, accent, only when unread. -->
                                    <Rectangle Grid.Column="0"
                                               Fill="{DynamicResource list.row.unread.bar.brush}"
                                               IsVisible="{Binding IsUnread}" />

                                    <!-- Two lines, laid out in the header columns: From,
                                         Subject and Received on top, preview beneath. -->
                                    <Grid Grid.Column="1"
                                          Margin="{Binding Indent}"
                                          RowDefinitions="Auto,Auto"
                                          ColumnDefinitions="150,*,Auto,Auto,100">
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding From}"
                                                   Classes.unread="{Binding IsUnread}"
                                                   FontWeight="{Binding SenderWeight}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding Subject}"
                                                   Classes.unread="{Binding IsUnread}"
                                                   FontWeight="{Binding SubjectWeight}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <!-- Category strip: one swatch per category, before
                                             the flag, as the reference lays them out. -->
                                        <ItemsControl Grid.Row="0" Grid.Column="2"
                                                      ItemsSource="{Binding CategoryTokens}"
                                                      IsVisible="{Binding HasCategories}"
                                                      Margin="0,0,6,0"
                                                      VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border Width="10" Height="10"
                                                            CornerRadius="2"
                                                            Background="{Binding
                                                                Converter={StaticResource TokenBrush}}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Grid.Row="0" Grid.Column="3"
                                                   Text="{Binding FlagGlyph}"
                                                   Margin="0,0,6,0"
                                                   Foreground="{DynamicResource status.danger.brush}" />
                                        <TextBlock Grid.Row="0" Grid.Column="4"
                                                   Name="RowDate"
                                                   Text="{Binding ReceivedLabel}"
                                                   Classes.unread="{Binding IsUnread}"
                                                   Classes="small"
                                                   HorizontalAlignment="Right"
                                                   TextTrimming="CharacterEllipsis" />
                                        <!--
                                            Hover actions. They occupy the received column's
                                            space rather than their own, so the row does not
                                            reflow under the pointer — the reference swaps the
                                            date for them rather than making room.
                                        -->
                                        <StackPanel Grid.Row="0" Grid.Column="4"
                                                    Name="RowActions"
                                                    Orientation="Horizontal"
                                                    Spacing="2"
                                                    HorizontalAlignment="Right"
                                                    IsVisible="False">
                                            <Button Classes="flat rowaction"
                                                    Tag="archive"
                                                    Content="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).ArchiveGlyph}"
                                                    FontFamily="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).IconFamily}"
                                                    ToolTip.Tip="Archive" />
                                            <Button Classes="flat rowaction"
                                                    Tag="delete"
                                                    Content="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).DeleteGlyph}"
                                                    FontFamily="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).IconFamily}"
                                                    ToolTip.Tip="Delete" />
                                            <Button Classes="flat rowaction"
                                                    Tag="flag"
                                                    Content="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).FlagActionGlyph}"
                                                    FontFamily="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).IconFamily}"
                                                    ToolTip.Tip="Flag" />
                                            <Button Classes="flat rowaction"
                                                    Tag="read"
                                                    Content="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).UnreadGlyph}"
                                                    FontFamily="{Binding $parent[ListBox].((vm:ShellViewModel)DataContext).IconFamily}"
                                                    ToolTip.Tip="Mark read or unread" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Grid.ColumnSpan="4"
                                                   Text="{Binding Preview}"
                                                   Classes="small secondary"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" />
                                        <!-- Which folder a cross-folder search found this in. -->
                                        <TextBlock Grid.Row="1" Grid.Column="4"
                                                   Text="{Binding FolderLabel}"
                                                   IsVisible="{Binding HasFolderLabel}"
                                                   Classes="small secondary"
                                                   HorizontalAlignment="Right"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                          </views:RowTemplateSelector>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="2" ResizeDirection="Columns" />

            <!-- Message list -->

            <GridSplitter Grid.Column="4"
                          IsVisible="{Binding ReadingPaneVisible}"
                          ResizeDirection="Columns" />

            <!-- Docked calendar. Takes the reading pane's right edge, exactly as the reference's
                 To-Do Bar calendar does, and carries a close button to undock. -->
            <ContentControl Grid.Column="6"
                            Name="DockHost"
                            IsVisible="{Binding IsCalendarDocked}" />

            <!-- Reading pane -->
            <Border Grid.Column="5"
                    IsVisible="{Binding ReadingPaneVisible}"
                    Background="{DynamicResource reading.background.brush}">
              <Grid>
                <!-- The read view. Covered by the inline compose host when a reply is open. -->
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource reading.header.background.brush}"
                            Padding="20,12"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource border.subtle.brush}">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding SelectedMessage.Subject}"
                                       FontSize="18"
                                       Margin="0,0,0,8"
                                       TextWrapping="Wrap" />

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding SelectedMessage.From}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedMessage.ToLine}"
                                           Classes="small secondary" />
                            </StackPanel>

                            <!-- the reference application puts Reply / Reply All / Forward at the top right of
                                 the reading pane, mirroring the Respond ribbon group. -->
                            <ItemsControl Grid.Row="1" Grid.Column="1"
                                          VerticalAlignment="Top"
                                          ItemsSource="{Binding ReadingPaneActions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:QuickAccessButton">
                                        <Button Padding="7,4" Command="{Binding Invoke}" ToolTip.Tip="{Binding Tip}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="{Binding Glyph}"
                                                           FontFamily="{Binding IconFamily}"
                                                           FontSize="15"
                                                           Foreground="{DynamicResource accent.rest.brush}" />
                                                <TextBlock Text="{Binding Label}"
                                                           Classes="small" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- What the message carries, above the message itself. -->
                    <ContentControl Name="ReadingAttachments" DockPanel.Dock="Top" />

                    <!-- The message itself, filled with a ReadingPaneBody: the InfoBars and
                         the web engine. Not markup, because what it holds depends on what the
                         sanitizer found in the message. -->
                    <ContentControl Name="ReadingBody" />
                </DockPanel>

                <!-- Inline reply. Grows over the read view when Reply / Reply All / Forward is
                     pressed and the Options page has not asked for a separate window. Filled from
                     code with the compact chrome and the shared ComposeSurface. -->
                <ContentControl Name="ReadingComposeHost" ZIndex="1" IsVisible="False" />
              </Grid>
            </Border>
        </Grid>
        </Border>

        <!-- Backstage. A full-window takeover across every row, so it covers the ribbon and
             the panes alike. -->

        <ContentControl Grid.Row="0" Grid.RowSpan="4" Grid.ColumnSpan="2"
                        Name="BackstageHost"
                        ZIndex="10"
                        IsVisible="False" />

        <!-- Floating peek layer. Sits over the panes so the peek can overlap them, which is
             what makes it a peek rather than another pane. -->
        <Canvas Grid.Row="2" Grid.Column="1" Name="PeekLayer" IsHitTestVisible="True" />

        <!-- ============================ Status bar =========================== -->
        <!--
            Undo Send's toast (§12). Over the workspace rather than in a row of its own: it is
            there for a few seconds and must not make the panes shorter while it is.
        -->
        <ContentControl Name="UndoSendHost" Grid.Row="2" Grid.Column="1"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" />

        <Border Grid.Row="3" Grid.ColumnSpan="2"
                Background="{DynamicResource statusbar.background.brush}"
                Height="{DynamicResource statusbar.height.value}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="10,0">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusLeft}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource statusbar.foreground.brush}"
                           FontSize="{DynamicResource type.ui.size.small.value}" />

                <TextBlock Grid.Column="2"
                           Text="{Binding StatusRight}"
                           Margin="0,0,14,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource statusbar.foreground.brush}"
                           FontSize="{DynamicResource type.ui.size.small.value}" />

                <!-- Layout toggles, then the zoom control, as the reference application parks them. -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                            VerticalAlignment="Center">
                    <Button Classes="flat"
                            Margin="2,0"
                            Command="{Binding ShowReadingPane}"
                            Content="{Binding ReadingPaneGlyph}"
                            FontFamily="{Binding IconFamily}"
                            FontSize="13"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource statusbar.foreground.brush}"
                            ToolTip.Tip="Normal" />
                    <Button Classes="flat"
                            Margin="2,0,10,0"
                            Command="{Binding HideReadingPane}"
                            Content="{Binding ReadingGlyph}"
                            FontFamily="{Binding IconFamily}"
                            FontSize="13"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource statusbar.foreground.brush}"
                            ToolTip.Tip="Reading" />

                    <Button Classes="flat"
                            Command="{Binding ZoomOut}"
                            Content="&#x2212;"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource statusbar.foreground.brush}"
                            ToolTip.Tip="Zoom out" />
                    <views:ZoomSlider Width="100"
                                      Margin="6,0"
                                      Minimum="50" Maximum="200"
                                      Value="{Binding ZoomPercent}"
                                      VerticalAlignment="Center"
                                      LineBrush="{DynamicResource statusbar.slider.brush}" />
                    <Button Classes="flat"
                            Margin="0,0,8,0"
                            Command="{Binding ZoomIn}"
                            Content="+"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource statusbar.foreground.brush}"
                            ToolTip.Tip="Zoom in" />
                    <TextBlock Text="{Binding ZoomLabel}"
                               MinWidth="34"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource statusbar.foreground.brush}"
                               FontSize="{DynamicResource type.ui.size.small.value}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Border>

</Window>
