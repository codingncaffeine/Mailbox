<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>mailbox</AssemblyName>
    <RootNamespace>Mailbox.App</RootNamespace>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Chromium hands its frames over as raw memory. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!--
    When this build was made, stamped into the assembly and shown by `Mailbox 0.1.0 (built …)`
    in the log and on the Backstage's About panel.

    The question it answers is the one that costs a session when it goes unasked: "am I looking
    at the build you just made, or the one that was already running?" A version number alone
    cannot answer it — every build of a working session carries the same one.
  -->
  <PropertyGroup>
    <InformationalVersion>$(VersionPrefix)+$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm'))</InformationalVersion>
  </PropertyGroup>

  <!-- The headless suite asserts menu contents, and several menus are internal statics. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Mailbox.HeadlessTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <!-- The native Wayland backend is not part of Avalonia.Desktop's platform detection; it is
         its own package (MIT, over the MIT NWayland bindings) and is selected at startup. It is
         the default on a Wayland session, because it is what speaks wp_fractional_scale_v1;
         MAILBOX_WAYLAND=0 pins X11 through XWayland. See WindowingBackend. -->
    <PackageReference Include="Avalonia.Wayland" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <!-- Structural only. Simple provides bare control templates so ListBox, ComboBox and
         GridSplitter have something to render; it contributes no colour, because every
         brush still comes from the token system. Control themes of our own replace it
         template by template, and this reference goes away when the last one lands. -->
    <PackageReference Include="Avalonia.Themes.Simple" Version="$(AvaloniaVersion)" />
    <!-- No Avalonia.Diagnostics: DevTools moved under the commercial licence at 12.x and is
         not published for this version. Not a runtime dependency either way. -->
  </ItemGroup>

  <!--
    Chromium, which draws messages, ships inside Mailbox: the binding (CefGlue, MIT) and the
    official Chromium Embedded Framework build it speaks to. The runtime package's own copy step
    is switched off — it drops its files into the output in a layout Chromium cannot find its
    resources in — and ChromiumFiles below lays them out instead, all under chromium/.
    See Chromium/ChromiumRuntime.cs.
  -->
  <ItemGroup>
    <PackageReference Include="CefGlue.Next.Core" Version="$(CefGlueVersion)" />
    <PackageReference Include="cef.runtime.linux-x64" Version="$(CefRuntimeVersion)" GeneratePathProperty="true"
                      ExcludeAssets="build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <!-- App icon, corners already cut to transparency. -->
    <AvaloniaResource Include="..\..\assets\icons\mailbox-*.png" Link="Assets/Icons/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The weather pictures: a day set and a night set, one file per condition, named by what
         they show. Embedded, as the app icon is, because they are drawn by the interface and
         nothing outside it needs a path to them. -->
    <AvaloniaResource Include="..\..\assets\weather\day\*.png" Link="Assets/Weather/day/%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\..\assets\weather\night\*.png" Link="Assets/Weather/night/%(Filename)%(Extension)" />
    <!-- The map's own base map, built by tools/weather-basemap.mjs from Natural Earth and us-atlas. -->
    <AvaloniaResource Include="..\..\assets\weather\map\basemap.bin" Link="Assets/Weather/map/basemap.bin" />
  </ItemGroup>

  <ItemGroup>
    <!-- The arrival sound, if this build ships one. A file rather than an embedded resource
         because it is handed to an external player, which needs a path; beside the binary rather
         than under assets/ because the .deb keeps this directory and drops that one. The glob
         matching nothing is a build with no sound of its own, which falls back to the desktop's
         own message-new-email — see Notifications/Sounds. -->
    <Content Include="..\..\assets\sounds\*.ogg" Link="sounds\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The translations, beside the binary rather than under assets/ for the reason the sound
         is: the .deb keeps this directory and drops that one. A build with no catalogues is the
         ordinary case and the glob matching nothing is how it stays harmless. -->
    <Content Include="..\..\assets\locales\*.po" Link="locales\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mailbox.Core\Mailbox.Core.csproj" />
    <ProjectReference Include="..\Mailbox.Dav\Mailbox.Dav.csproj" />
    <ProjectReference Include="..\Mailbox.Google\Mailbox.Google.csproj" />
    <ProjectReference Include="..\Mailbox.Theming\Mailbox.Theming.csproj" />
    <ProjectReference Include="..\Mailbox.Controls.Calendar\Mailbox.Controls.Calendar.csproj" />
    <ProjectReference Include="..\Mailbox.Controls.Journal\Mailbox.Controls.Journal.csproj" />
    <ProjectReference Include="..\Mailbox.Controls.Notes\Mailbox.Controls.Notes.csproj" />
    <ProjectReference Include="..\Mailbox.Controls.People\Mailbox.Controls.People.csproj" />
    <ProjectReference Include="..\Mailbox.Controls.Ribbon\Mailbox.Controls.Ribbon.csproj" />
    <ProjectReference Include="..\Mailbox.Controls.Tasks\Mailbox.Controls.Tasks.csproj" />
    <ProjectReference Include="..\Mailbox.Scheduling\Mailbox.Scheduling.csproj" />
    <ProjectReference Include="..\Mailbox.Store\Mailbox.Store.csproj" />
    <ProjectReference Include="..\Mailbox.Protocols\Mailbox.Protocols.csproj" />
    <ProjectReference Include="..\Mailbox.Editor\Mailbox.Editor.csproj" />
    <ProjectReference Include="..\Mailbox.Rendering\Mailbox.Rendering.csproj" />
    <ProjectReference Include="..\Mailbox.Security\Mailbox.Security.csproj" />
    <ProjectReference Include="..\Mailbox.Plugins\Mailbox.Plugins.csproj" />
    <ProjectReference Include="..\Mailbox.Import\Mailbox.Import.csproj" />
  </ItemGroup>

  <!--
    Chromium's files, laid out the way it looks for them: libcef.so, its snapshots, the .pak
    resources and icudtl.dat side by side, the locale paks under locales/. And its helper: a
    native program of a few lines (packaging/chromium), because the Linux sandbox needs a
    single-threaded process to enter its namespaces and no .NET process is one.
  -->
  <PropertyGroup>
    <ChromiumSource>$(Pkgcef_runtime_linux-x64)/CEF/linux-x64</ChromiumSource>
    <ChromiumHelperSource>$(MSBuildThisFileDirectory)../../packaging/chromium/mailbox-cef-helper.c</ChromiumHelperSource>
  </PropertyGroup>

  <!-- linux-x64, and a build with no runtime named on an x64 machine. Chromium is the x64 build of
       CEF; an arm64 publish carries none and its reading pane renders text. -->
  <PropertyGroup>
    <ChromiumShips Condition="$([MSBuild]::IsOSPlatform('Linux')) And ('$(RuntimeIdentifier)' == 'linux-x64' Or ('$(RuntimeIdentifier)' == '' And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'))">true</ChromiumShips>
  </PropertyGroup>

  <ItemGroup Condition="'$(ChromiumShips)' == 'true'">
    <!-- chrome-sandbox is Chromium's setuid fallback; nothing sets it up, and found unconfigured
         it makes Chromium abort rather than use the namespaces Mailbox checked for. -->
    <ChromiumBinary Include="$(ChromiumSource)/*.*" Exclude="$(ChromiumSource)/chrome-sandbox" />
    <ChromiumResource Include="$(ChromiumSource)/Resources/*.*" />
    <ChromiumLocale Include="$(ChromiumSource)/Resources/locales/*.pak" />
  </ItemGroup>

  <Target Name="ChromiumIntoOutput" AfterTargets="Build" Condition="'$(ChromiumShips)' == 'true'">
    <Copy SourceFiles="@(ChromiumBinary);@(ChromiumResource)" DestinationFolder="$(OutDir)chromium" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ChromiumLocale)" DestinationFolder="$(OutDir)chromium/locales" SkipUnchangedFiles="true" />
    <Exec Command="gcc -O2 -Wall -Wextra -Werror -o &quot;$(OutDir)chromium/mailbox-cef-helper&quot; &quot;$(ChromiumHelperSource)&quot; -L&quot;$(OutDir)chromium&quot; -lcef -Wl,-rpath,'$ORIGIN'" />
  </Target>

  <Target Name="ChromiumIntoPublish" AfterTargets="Publish" Condition="'$(ChromiumShips)' == 'true'">
    <Copy SourceFiles="@(ChromiumBinary);@(ChromiumResource)" DestinationFolder="$(PublishDir)chromium" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ChromiumLocale)" DestinationFolder="$(PublishDir)chromium/locales" SkipUnchangedFiles="true" />
    <Exec Command="gcc -O2 -Wall -Wextra -Werror -o &quot;$(PublishDir)chromium/mailbox-cef-helper&quot; &quot;$(ChromiumHelperSource)&quot; -L&quot;$(PublishDir)chromium&quot; -lcef -Wl,-rpath,'$ORIGIN'" />
  </Target>

</Project>
