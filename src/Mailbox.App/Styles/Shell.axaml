<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Base chrome styling. Every colour here comes from a token; nothing is literal.
        SimpleTheme supplies the control templates but carries its own palette, so anything
        it colours has to be overridden here or its scheme shows through — the search box
        rendering black was exactly that.
    -->

    <!-- ============================== Typography ============================== -->

    <!--
        Text rendering mode is NOT set here. Avalonia 12.1 exposes TextOptions through
        Get/Set methods rather than public attached-property fields, so XAML cannot reach it.
        TextRendering.Apply() sets it on the window in code, which also lets the mode be
        switched at runtime for the investigation in docs/text-rendering.md.
    -->
    <!-- The hairline round every window, measured off the reference's four themes: what
         tells a light window from the light one under it — a compose window over the White
         shell was invisible without it. Maximized, there is no edge to tell apart and the
         line goes, as the reference's does. -->
    <Style Selector="Border.windowshape">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource window.border.brush}" />
    </Style>

    <Style Selector="Window[WindowState=Maximized] Border.windowshape">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- The content stands 1px inside the hairline, exactly as it did when the line was the
         outer border's own stroke — the ring paints the gap, and the whole calibrated layout
         keeps its measured positions. Maximized drops the inset with the line. -->
    <Style Selector=":is(Control).windowinset">
        <Setter Property="Margin" Value="1" />
    </Style>

    <Style Selector="Window[WindowState=Maximized] :is(Control).windowinset">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource ui.fontfamily}" />
        <Setter Property="FontSize" Value="{DynamicResource type.ui.size.value}" />
        <Setter Property="Foreground" Value="{DynamicResource text.primary.brush}" />
    </Style>

    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource text.secondary.brush}" />
    </Style>

    <Style Selector="TextBlock.small">
        <Setter Property="FontSize" Value="{DynamicResource type.ui.size.small.value}" />
    </Style>

    <!-- ================================ Buttons =============================== -->

    <Style Selector="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource text.primary.brush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontFamily" Value="{DynamicResource ui.fontfamily}" />
        <Setter Property="FontSize" Value="{DynamicResource type.ui.size.value}" />
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource state.hover.brush}" />
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="{DynamicResource state.pressed.brush}" />
    </Style>

    <!--
        Every button on the ribbon, in every window that has one. The reference lights the button
        under the pointer with a rounded fill and no line round it; a line appears only on a split
        button, whose two halves have to be told apart, and on a button whose menu is open.

        These rules exist because the buttons no longer set their own Background in code: a local
        value beats every style setter, which is why the bar had no hover state at all.
    -->
    <Style Selector="Button.ribbonbutton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!--
        A button whose command is on. The reference boxes it: measured off the Folder tab's Add
        to Favorites, a #CCCCCC face inside a #5C5C5C line on Dark Gray's #BDBDBD ribbon — the
        same pair a dropdown wears while its menu is open, because both mean "this one".

        Declared above the hover rule on purpose, so a checked button under the pointer still
        lights: the line is what says "on", and the fill is free to answer the pointer.
    -->
    <Style Selector="Button.ribbonbutton.checked">
        <Setter Property="Background" Value="{DynamicResource ribbon.button.open.brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ribbon.button.open.border.brush}" />
    </Style>

    <!--
        The same state inside a gallery box, which the reference fills a shade lighter: #D1D1D1,
        measured off the View tab's Arrangement with Date the current one.
    -->
    <Style Selector="Button.ribbonbutton.galleryentry.checked">
        <Setter Property="Background" Value="{DynamicResource ribbon.button.hover.brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ribbon.button.open.border.brush}" />
    </Style>

    <Style Selector="Button.ribbonbutton:pointerover">
        <Setter Property="Background" Value="{DynamicResource ribbon.button.hover.brush}" />
    </Style>

    <Style Selector="Button.ribbonbutton:pressed">
        <Setter Property="Background" Value="{DynamicResource ribbon.button.open.brush}" />
    </Style>

    <Style Selector="Button.ribbonbutton:disabled">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!--
        The tab strip. Same story as the buttons above: these were bound in code, the local value
        beat the style setters, and so ribbon.tab.hover was a token every theme defined and
        nothing read.

        The selected rule comes last on purpose. A tab that is already showing does not answer
        the pointer — being selected is the stronger statement, and the reference leaves it
        alone — so it wins over the hover rule rather than the other way round.
    -->
    <Style Selector="Button.ribbontab">
        <Setter Property="Background" Value="{DynamicResource ribbon.tab.rest.brush}" />
    </Style>

    <Style Selector="Button.ribbontab:pointerover">
        <Setter Property="Background" Value="{DynamicResource ribbon.tab.hover.brush}" />
    </Style>

    <!-- Deliberately after :pointerover, so the selected tab does not answer the pointer: a
         tab already showing has nothing to offer a hover, and no reference capture shows a
         hovered selected tab to copy. Swapping the two blocks is the whole fix if an owner
         ever says otherwise. -->
    <Style Selector="Button.ribbontab.selected">
        <Setter Property="Background" Value="{DynamicResource ribbon.tab.selected.brush}" />
    </Style>

    <!--
        A split button's two halves: one box round both, a divider between them, and only the half
        under the pointer filled. The container carries the line; each half carries its own fill.
    -->
    <Style Selector="Border.ribbonsplit">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Border.ribbonsplit.hovered">
        <Setter Property="BorderBrush" Value="{DynamicResource ribbon.button.split.border.brush}" />
    </Style>

    <Style Selector="Border.ribbonsplitdivider">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.ribbonsplitdivider.hovered">
        <Setter Property="Background" Value="{DynamicResource ribbon.button.split.border.brush}" />
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Foreground" Value="{DynamicResource text.disabled.brush}" />
    </Style>

    <!-- ============================ Ticks and radios =========================== -->

    <!--
        The control theme's box is transparent with a faint outline, which reads as a box only
        while the surface behind it is light. Every tick in Mailbox is in a dialog, and a
        dialog's ground is dark in two of the four themes — there the box vanished and left a
        tick floating on its own.

        The reference fills a checked box with the accent and draws a light tick in it. The
        control theme paints its tick from HighlightBrush, which is the accent, so filling the
        box that way would draw the tick in its own colour; a light box with an accent tick is
        the same reading in every theme, and a control theme of our own is what it takes to do
        it the other way round.
    -->
    <Style Selector="CheckBox">
        <Setter Property="Background" Value="{DynamicResource dialog.surface.brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource dialog.border.brush}" />
    </Style>

    <!--
        Except on the ribbon, where the box is not a dialog's. Measured off the View capture, the
        reference leaves it transparent — the box is the bar's own colour — inside a line of its
        own. A dialog's fill there reads as a hole in the bar, which on Black is exactly what it
        was: a #1F1F1F square on a #292929 ribbon.
    -->
    <Style Selector="CheckBox.ribboncheck">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource ribbon.tick.border.brush}" />
    </Style>

    <!--
        A radio's template paints Background over its whole root — label and all — so giving
        it the box fill drew a light bar the width of the row. The disc is the template's own
        ellipse, and it takes its fill by name.
    -->
    <Style Selector="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource dialog.border.brush}" />
    </Style>

    <Style Selector="RadioButton /template/ Ellipse#border">
        <Setter Property="Fill" Value="{DynamicResource dialog.surface.brush}" />
    </Style>

    <!-- ============================== Text input ============================== -->

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource surface.ground.brush}" />
        <Setter Property="Foreground" Value="{DynamicResource text.primary.brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource border.subtle.brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource text.primary.brush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource state.selected.brush}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource text.primary.brush}" />
        <Setter Property="FontFamily" Value="{DynamicResource ui.fontfamily}" />
    </Style>

    <Style Selector="TextBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource border.strong.brush}" />
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource border.focus.brush}" />
    </Style>

    <Style Selector="TextBox /template/ TextBlock#PART_Watermark,
                     TextBox /template/ TextBlock#PART_FloatingWatermark">
        <Setter Property="Foreground" Value="{DynamicResource text.secondary.brush}" />
    </Style>

    <!--
        The title-bar search box stands on the light search fill rather than the app surface,
        so its text, caret and placeholder all take the search token. The general secondary
        text colour is tuned for the content area and is close to invisible here.
    -->
    <Style Selector="TextBox.titlebar-search">
        <Setter Property="CaretBrush" Value="{DynamicResource titlebar.search.text.brush}" />
        <Setter Property="SelectionForegroundBrush"
                Value="{DynamicResource titlebar.search.text.brush}" />
    </Style>

    <Style Selector="TextBox.titlebar-search /template/ TextBlock#PART_Watermark">
        <Setter Property="Foreground" Value="{DynamicResource titlebar.search.text.brush}" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="TextBox.titlebar-search /template/ TextBlock#PART_FloatingWatermark">
        <Setter Property="Foreground" Value="{DynamicResource titlebar.search.text.brush}" />
    </Style>

    <!-- ================================ ComboBox ============================== -->

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource surface.ground.brush}" />
        <Setter Property="Foreground" Value="{DynamicResource text.primary.brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource border.subtle.brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource ui.fontfamily}" />
    </Style>

    <Style Selector="ComboBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource border.strong.brush}" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource text.primary.brush}" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style Selector="ComboBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource state.hover.brush}" />
    </Style>

    <Style Selector="ComboBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource state.selected.brush}" />
    </Style>

    <!-- ============================== Popups/menus ============================ -->

    <!-- Kept as separate blocks: a grouped selector resolves to the common base type, which
         has no Background, and fails to compile. -->
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource surface.overlay.brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource border.subtle.brush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource surface.overlay.brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource border.subtle.brush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource surface.overlay.brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource border.subtle.brush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource text.primary.brush}" />
    </Style>

    <Style Selector="MenuItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource state.hover.brush}" />
    </Style>

    <!--
        The entry under the pointer, and the one whose submenu is open. Both are ":selected" to
        the control theme, which paints the row's own border directly and so beats the background
        above. Left alone it reaches for an accent brush nothing here publishes, and the row comes
        out filled with the stock blue — the one colour in an open menu that belonged to no theme.
        A wash rather than a band with an edge: the reference draws no border round the entry the
        pointer is on.
    -->
    <Style Selector="MenuItem:selected /template/ Border#root">
        <Setter Property="Background" Value="{DynamicResource state.hover.brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource state.hover.brush}" />
    </Style>

    <!--
        A submenu is a popup of the entry's own rather than another flyout, so the presenter style
        above never reaches it: the control theme paints it from the window's ground, and a
        submenu came out a different colour from the menu it hangs off in the two themes where
        ground and overlay differ. Same surface, same edge.
    -->
    <Style Selector="MenuItem /template/ Popup Border">
        <Setter Property="Background" Value="{DynamicResource surface.overlay.brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource border.subtle.brush}" />
    </Style>

    <!--
        The rules between the menu's groups take the stronger border rather than the subtle one
        every other separator uses. Measured at #858585 against the menu's own #BDBDBD, which is
        this theme's strong border almost exactly; the subtle one is #565656 there and draws a
        rule far heavier than the reference's on a surface that dark.
    -->
    <Style Selector="MenuFlyoutPresenter Separator">
        <Setter Property="Background" Value="{DynamicResource border.strong.brush}" />
    </Style>

    <Style Selector="MenuItem:separator /template/ Separator">
        <Setter Property="Background" Value="{DynamicResource border.strong.brush}" />
    </Style>

    <!--
        A screentip is the desktop's, not the theme's. The reference draws it as a light box in
        every theme — measured #F0F0F0 on Dark Gray, where nothing else in the window is — for the
        same reason Account Settings is light everywhere: it is an OS tooltip, and the OS does not
        know which Office theme is on. So it takes the systemdialog palette rather than the
        content one.
    -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource systemdialog.background.brush}" />
        <Setter Property="Foreground" Value="{DynamicResource systemdialog.foreground.brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource systemdialog.tooltip.border.brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MaxWidth" Value="280" />
        <Setter Property="FontFamily" Value="{DynamicResource ui.fontfamily}" />
        <Setter Property="FontSize" Value="{DynamicResource type.ui.size.value}" />
    </Style>

    <!-- =============================== Scrollbars ============================= -->

    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource surface.sunken.brush}" />
    </Style>

    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource border.strong.brush}" />
    </Style>

    <Style Selector="ScrollBar /template/ Thumb:pointerover">
        <Setter Property="Background" Value="{DynamicResource text.secondary.brush}" />
    </Style>

    <Style Selector="ScrollBar /template/ RepeatButton">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Zoom slider in the status bar sits on the accent bar, so it takes that foreground. -->
    <!-- ================================ Lists ================================= -->

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource text.primary.brush}" />
    </Style>

    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource state.hover.brush}" />
    </Style>

    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource state.selected.brush}" />
    </Style>

    <Style Selector="ListBoxItem:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource state.selected.brush}" />
    </Style>

    <!-- A list that does not hold the focus dims its selection, as the reference does: the
         saturated band follows the keyboard, and the dimmed one says "this was yours" from the
         list the reader has left. Every built-in defines the token; nothing read it before. -->
    <Style Selector="ListBox:not(:focus-within) ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource state.selectedinactive.brush}" />
    </Style>

    <Style Selector="ListBox:not(:focus-within) ListBoxItem:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource state.selectedinactive.brush}" />
    </Style>

    <!-- ================================= Tabs ================================== -->
    <!-- Dialog tabs. The control theme's palette follows our tokens now, but a tab strip is
         prominent enough to be worth saying explicitly rather than inheriting. -->
    <Style Selector="TabControl">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource text.primary.brush}" />
        <Setter Property="FontSize" Value="{DynamicResource type.ui.size.value}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="TabItem:selected">
        <Setter Property="Background" Value="{DynamicResource surface.raised.brush}" />
        <Setter Property="Foreground" Value="{DynamicResource text.primary.brush}" />
    </Style>

    <Style Selector="TabItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource state.hover.brush}" />
    </Style>

    <Style Selector="TabItem:disabled">
        <Setter Property="Foreground" Value="{DynamicResource text.disabled.brush}" />
    </Style>

    <!-- ============================ Backstage menus ============================= -->
    <!-- The two-line items behind Account Settings and Tools: a title and a sentence under it.
         Both lines come from tokens, so the secondary line stays legible on every theme. -->
    <Style Selector="TextBlock.menu-title">
        <Setter Property="Foreground" Value="{DynamicResource text.primary.brush}" />
    </Style>

    <Style Selector="TextBlock.menu-detail">
        <Setter Property="Foreground" Value="{DynamicResource text.secondary.brush}" />
        <Setter Property="FontSize" Value="{DynamicResource type.ui.size.small.value}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="260" />
    </Style>

    <Style Selector="MenuItem:disabled">
        <Setter Property="Foreground" Value="{DynamicResource text.disabled.brush}" />
    </Style>

    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource border.subtle.brush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- ======================== Flat header controls =========================== -->
    <!--
        Filter pivots, column headers, group headers, the pane collapse and the status bar's
        controls. They read as text rather than as buttons, so they carry no chrome of their
        own until hovered — but they are buttons, and the colour comes from a token like
        everything else. Drawn as TextBlocks they looked clickable and were not.
    -->
    <Style Selector="Button.flat">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="3,1" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.flat:pointerover">
        <Setter Property="Background" Value="{DynamicResource state.hover.brush}" />
    </Style>

    <Style Selector="Button.flat:pressed">
        <Setter Property="Background" Value="{DynamicResource state.pressed.brush}" />
    </Style>

    <!--
        A pane row a feed is being dragged onto. Marked while the pointer is over it, because a
        drag with nothing showing where it would land is a drag nobody can aim.
    -->
    <Style Selector="Button.flat.droptarget">
        <Setter Property="Background" Value="{DynamicResource accent.subtle.brush}" />
    </Style>

    <!-- ============================= Row actions =============================== -->
    <!--
        The buttons that appear on a message row under the pointer. Hidden rather than
        transparent: a transparent button still takes the click, and a row whose date cannot be
        selected because an invisible Delete is sitting on it is a nasty bug to find.
    -->
    <Style Selector="ListBoxItem:pointerover StackPanel#RowActions">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- The actions sit over the row's right end; they take the row's own ground so what is
         under them does not show through, selected or not. -->
    <Style Selector="StackPanel#RowActions">
        <Setter Property="Background" Value="{DynamicResource list.row.background.brush}" />
    </Style>
    <Style Selector="ListBoxItem:selected StackPanel#RowActions">
        <Setter Property="Background" Value="{DynamicResource list.row.selected.brush}" />
    </Style>

    <Style Selector="ListBoxItem:pointerover TextBlock#RowDate">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="Button.rowaction">
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource text.secondary.brush}" />
    </Style>

    <Style Selector="Button.rowaction:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource text.primary.brush}" />
        <Setter Property="Background" Value="{DynamicResource state.hover.brush}" />
    </Style>

    <!-- =========================== Account button ============================= -->
    <!-- While its panel is open the button reads as pressed: a light box with a hairline
         border around the circle, measured off the capture. -->
    <Style Selector="Button.account">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Button.account:pointerover">
        <Setter Property="Background" Value="{DynamicResource state.hover.brush}" />
    </Style>

    <Style Selector="Button.account:flyout-open">
        <Setter Property="Background" Value="{DynamicResource surface.overlay.brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource border.strong.brush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- The panel itself carries no padding of its own; the sections inside supply it. -->
    <Style Selector="FlyoutPresenter.account">
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{DynamicResource surface.overlay.brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource border.strong.brush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ========================== Caption buttons ============================= -->
    <!-- Windows hover behaviour: neutral wash on minimize and maximize, red on close. -->

    <!-- Glyphs follow the button's Foreground, so hover recolours them through it. -->
    <Style Selector="Button.caption">
        <Setter Property="Foreground" Value="{DynamicResource titlebar.foreground.brush}" />
    </Style>

    <Style Selector="Button.caption-close">
        <Setter Property="Foreground" Value="{DynamicResource titlebar.foreground.brush}" />
    </Style>

    <!-- A dialog's caption stands on the dialog's ground, which is the opposite end of the
         ramp from the title bar's in two of the four themes. -->
    <Style Selector="Button.caption.on-dialog">
        <Setter Property="Foreground" Value="{DynamicResource dialog.foreground.brush}" />
    </Style>

    <Style Selector="Button.caption-close.on-dialog">
        <Setter Property="Foreground" Value="{DynamicResource dialog.foreground.brush}" />
    </Style>

    <!--
        The neutral wash, which is a wash rather than a colour: Windows lightens a dark caption
        under the pointer and darkens a light one. Which way round depends on what the button
        is standing on, and that is three different answers inside one theme — the title bar,
        a dialog's own ground, and the system dialogs' desktop-light band — so each has its own
        pair rather than the one literal that used to be here. A white wash over White's own
        #E9EEF2 caption, and over any light theme's white dialog, was invisible.
    -->
    <Style Selector="Button.caption:pointerover">
        <Setter Property="Background" Value="{DynamicResource titlebar.caption.hover.brush}" />
    </Style>

    <Style Selector="Button.caption:pressed">
        <Setter Property="Background" Value="{DynamicResource titlebar.caption.pressed.brush}" />
    </Style>

    <Style Selector="Button.caption.on-dialog:pointerover">
        <Setter Property="Background" Value="{DynamicResource dialog.caption.hover.brush}" />
    </Style>

    <Style Selector="Button.caption.on-dialog:pressed">
        <Setter Property="Background" Value="{DynamicResource dialog.caption.pressed.brush}" />
    </Style>

    <Style Selector="Button.caption.on-system:pointerover">
        <Setter Property="Background" Value="{DynamicResource systemdialog.caption.hover.brush}" />
    </Style>

    <Style Selector="Button.caption.on-system:pressed">
        <Setter Property="Background" Value="{DynamicResource systemdialog.caption.pressed.brush}" />
    </Style>

    <!-- White glyph on the red, whatever the theme's caption colour normally is. -->
    <Style Selector="Button.caption-close:pointerover">
        <Setter Property="Background" Value="{DynamicResource titlebar.caption.close.brush}" />
        <Setter Property="Foreground" Value="{DynamicResource titlebar.caption.close.text.brush}" />
    </Style>

    <Style Selector="Button.caption-close:pressed">
        <Setter Property="Background" Value="{DynamicResource titlebar.caption.close.pressed.brush}" />
        <Setter Property="Foreground" Value="{DynamicResource titlebar.caption.close.text.brush}" />
    </Style>

    <!--
        The held state, made visible. Every rule above sets the button's own Background and every
        theme defines all six pressed tokens — but the control theme has its own ":pressed" rule
        that fills PART_ContentPresenter, which is drawn on top, so a held caption button
        photographed as the general button wash and not one of those tokens was ever seen. Dark
        Gray measured #B0B0B0 on all three buttons, the close button's lighter red included.

        The presenter is not drawn *over* the button's Background; it is what draws it, through
        the control theme's template binding. So that theme's own ":pressed" rule, which sets the
        presenter's Background to a fixed brush, replaces the binding and the token with it.
        Standing the presenter aside was tried first and is worse: transparent removes the paint
        altogether, and a held button then photographs exactly like a resting one — which is what
        the capture showed, byte-identical, and is why this comment is not the one that was here.
        The token has to be restated at the presenter, where being later beats the rule that
        broke it.

        Four rules and not one: each family names a different token and there is nothing to
        inherit. Hover needs no equivalent — the control theme has no presenter-level
        :pointerover rule, which is why hover was right all along and only the held state was not.
    -->
    <Style Selector="Button.caption:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource titlebar.caption.pressed.brush}" />
    </Style>

    <Style Selector="Button.caption.on-dialog:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource dialog.caption.pressed.brush}" />
    </Style>

    <Style Selector="Button.caption.on-system:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource systemdialog.caption.pressed.brush}" />
    </Style>

    <!--
        The app rail's icons. Their own pair, for the reason the ribbon's buttons have theirs:
        with no class of their own these took the generic Button:pointerover above, which is
        state.hover — the *content* palette. Measured on the rail's own ground that was two units
        apart in Colorful and White (no hover at all) and a near-white #C9C9C9 block on Dark
        Gray's dark chrome. The rail is chrome, so it takes a wash over its own ground.

        Transparent at rest so the rail's Background shows: a local value here would beat these
        rules, which is the fault this file already records twice above.
    -->
    <Style Selector="Button.railitem">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.railitem:pointerover">
        <Setter Property="Background" Value="{DynamicResource rail.item.hover.brush}" />
    </Style>

    <Style Selector="Button.railitem:pressed">
        <Setter Property="Background" Value="{DynamicResource rail.item.pressed.brush}" />
    </Style>

    <Style Selector="Button.railitem:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource rail.item.pressed.brush}" />
    </Style>

    <Style Selector="Button.caption-close:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource titlebar.caption.close.pressed.brush}" />
    </Style>

    <!-- ============================= Dialog contents =========================== -->

    <!--
        Everything inside a dialog takes the dialog's colours by default, rather than each
        dialog naming them control by control. The same reasoning as repointing the control
        theme's palette: a surface nobody has thought about yet still comes out right.

        Anything that sets its own is unaffected, because a local value beats a style setter —
        which is what lets the Options pages keep their explicit bindings and the destructive
        button in a confirmation stay red.
    -->
    <Style Selector="Border.dialogroot TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource dialog.foreground.brush}" />
    </Style>

    <!--
        The caption buttons are inside a dialog too, and are not that kind of button; nor is
        anything classed "plain", which is how a control that is a button only mechanically —
        a fold arrow in a tree — opts out of being drawn as one.
    -->
    <Style Selector="Border.dialogroot Button:not(.caption):not(.caption-close):not(.plain)">
        <Setter Property="Background" Value="{DynamicResource dialog.surface.brush}" />
        <Setter Property="Foreground" Value="{DynamicResource dialog.surface.text.brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource dialog.border.brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinWidth" Value="74" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- A list in a dialog is a box on the ground, as the reference draws it. Lists elsewhere
         are transparent because they sit on a pane of their own. -->
    <Style Selector="Border.dialogroot ListBox">
        <Setter Property="Background" Value="{DynamicResource dialog.surface.brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource dialog.border.brush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Ink inside that box is the box's, not the ground's — declared after the rule above so
         it wins for the rows, which build their own text rather than getting a presenter's. -->
    <Style Selector="Border.dialogroot ListBox TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource dialog.surface.text.brush}" />
    </Style>

    <!--
        Fields and combo boxes in a dialog are boxes on the ground as well. The reference draws
        them in the same fill and line as the list boxes (Dark Gray: #BDBDBD inside #808080,
        with #262626 ink), where the general field styles above paint the content surface,
        which is a different shade of grey in that theme.
    -->
    <Style Selector="Border.dialogroot TextBox">
        <Setter Property="Background" Value="{DynamicResource dialog.surface.brush}" />
        <Setter Property="Foreground" Value="{DynamicResource dialog.surface.text.brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource dialog.border.brush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource dialog.surface.text.brush}" />
        <Setter Property="SelectionForegroundBrush"
                Value="{DynamicResource dialog.surface.text.brush}" />
    </Style>

    <!-- Declared after the rule above, or its BorderBrush would win over these too. -->
    <Style Selector="Border.dialogroot TextBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource border.strong.brush}" />
    </Style>

    <Style Selector="Border.dialogroot TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource border.focus.brush}" />
    </Style>

    <Style Selector="Border.dialogroot ComboBox">
        <Setter Property="Background" Value="{DynamicResource dialog.surface.brush}" />
        <Setter Property="Foreground" Value="{DynamicResource dialog.surface.text.brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource dialog.border.brush}" />
    </Style>

    <Style Selector="Border.dialogroot ComboBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource border.strong.brush}" />
    </Style>

    <!--
        A combo box shows its selection through a presenter that builds a TextBlock, and that
        TextBlock is a descendant of the dialog root — so the ground-ink rule at the top of this
        block reached it and painted the selected item in the ground's colour on the box's fill:
        white on light grey in Dark Gray. A text box is immune, because it draws through a
        TextPresenter, which is what made the two look different in the same dialog.
    -->
    <Style Selector="Border.dialogroot ComboBox TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource dialog.surface.text.brush}" />
    </Style>

    <!-- Unread messages are blue in the reference application, not merely bold. -->
    <Style Selector="TextBlock.unread">
        <Setter Property="Foreground" Value="{DynamicResource list.row.unread.text.brush}" />
    </Style>

    <!-- Module switcher: the active module is accented, the rest are quiet. -->
    <Style Selector="Button.active > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource rail.item.active.brush}" />
    </Style>

    <!--
        Splitters are invisible at rest. the reference application draws no rule between the folder pane, the
        message list and the reading pane — the panes simply abut, and their own background
        colours are what separate them. The splitter only shows on hover, as a grab hint.
    -->
    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinWidth" Value="1" />
        <Setter Property="MinHeight" Value="1" />
    </Style>

    <Style Selector="GridSplitter:pointerover">
        <Setter Property="Background" Value="{DynamicResource accent.rest.brush}" />
    </Style>

</Styles>
