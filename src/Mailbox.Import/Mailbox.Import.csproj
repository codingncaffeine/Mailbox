<Project Sdk="Microsoft.NET.Sdk">

  <!--
    §16's importers, beginning with Maildir — the most likely migration source for this
    audience: Dovecot and Courier trees, Evolution, KMail, mutt and offlineimap all keep one.
    An importer reads somebody else's store without ever writing to it, files messages through
    the same repository the receivers use, and answers with a report rather than a log — what
    was brought, what was skipped, and why, because a migration is the one operation a reader
    checks by count.
  -->

  <ItemGroup>
    <InternalsVisibleTo Include="Mailbox.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mailbox.Store\Mailbox.Store.csproj" />
    <ProjectReference Include="..\Mailbox.Protocols\Mailbox.Protocols.csproj" />
    <ProjectReference Include="..\Mailbox.Scheduling\Mailbox.Scheduling.csproj" />
    <ProjectReference Include="..\Mailbox.Contacts\Mailbox.Contacts.csproj" />
  </ItemGroup>

</Project>
