<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Journal module's views: the timeline the module opens in, and the grouped rows its
    other three arrangements draw. Drawn, as every module's views are.

    Its own project rather than the Notes one, even though the two modules read the same component
    out of the same table: they are two modules, a theme states them separately, and a timeline
    has nothing in common with a wall of squares but the store underneath it.
  -->

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mailbox.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mailbox.Controls.Common\Mailbox.Controls.Common.csproj" />
    <ProjectReference Include="..\Mailbox.Core\Mailbox.Core.csproj" />
    <ProjectReference Include="..\Mailbox.Scheduling\Mailbox.Scheduling.csproj" />
    <ProjectReference Include="..\Mailbox.Theming\Mailbox.Theming.csproj" />
  </ItemGroup>

</Project>
