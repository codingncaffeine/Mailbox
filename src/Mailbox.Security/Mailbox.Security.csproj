<Project Sdk="Microsoft.NET.Sdk">

  <!--
    What a message claims about itself and whether it holds up: DKIM, SPF and DMARC results,
    lookalike sender domains, display-name spoofing. Reads headers; talks to nothing.
  -->

  <ItemGroup>
    <PackageReference Include="MimeKit" Version="$(MailKitVersion)" />
    <!-- Named here because this project compiles against it, not because MimeKit brings it. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="$(BouncyCastleVersion)" />
    <!-- The certificate store is a SQLite file, and MimeKit's own file-name constructor can only
         find System.Data.SQLite. The same provider the mail store already uses is handed to
         MimeKit as a connection instead, so nothing new is shipped — see CertificateStore. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="$(SqliteVersion)" />
    <PackageReference Include="SQLite3MC.PCLRaw.bundle" Version="$(SqliteCiphersVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mailbox.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mailbox.Core\Mailbox.Core.csproj" />
  </ItemGroup>

</Project>
