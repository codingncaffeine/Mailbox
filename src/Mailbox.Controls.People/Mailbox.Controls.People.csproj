<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The People module's views (§9). Drawn rather than composed for the reason the calendar's are:
    an address book is a long list of short rows, and a control per row is a control per row.
    What is here is what the reference draws and Avalonia has no equivalent of — the contact list
    with the alphabet index down its side, and the card that shows one person.
  -->

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mailbox.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mailbox.Contacts\Mailbox.Contacts.csproj" />
    <ProjectReference Include="..\Mailbox.Controls.Common\Mailbox.Controls.Common.csproj" />
    <ProjectReference Include="..\Mailbox.Core\Mailbox.Core.csproj" />
    <ProjectReference Include="..\Mailbox.Theming\Mailbox.Theming.csproj" />
  </ItemGroup>

</Project>
