<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Talking to mail servers: IMAP, POP3 and SMTP. MailKit does the protocol;
    what lives here is the policy around it — what to download, what to leave, when to retry.
  -->

  <ItemGroup>
    <PackageReference Include="MailKit" Version="$(MailKitVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mailbox.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The United States ZIP codes the place search finds itself, built by tools/weather-zipcodes.mjs. -->
    <EmbeddedResource Include="..\..\assets\weather\places\us-zip.tsv.gz" LogicalName="Mailbox.Protocols.us-zip.tsv.gz" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mailbox.Core\Mailbox.Core.csproj" />
    <ProjectReference Include="..\Mailbox.Store\Mailbox.Store.csproj" />
    <ProjectReference Include="..\Mailbox.Security\Mailbox.Security.csproj" />
  </ItemGroup>

</Project>
