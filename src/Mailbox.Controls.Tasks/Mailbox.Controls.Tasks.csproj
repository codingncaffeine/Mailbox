<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Tasks module's view. Drawn rather than composed for the reason the People list is:
    a to-do list is a long run of short rows under group headings, and a control per row is a
    control per row.

    This is the second caller that had to exist before deciding whether the message list's
    engine should move out of the application. It does not want that engine: the
    reference draws this list with the same chrome — 26px group headings, 21px rows — but its
    columns, its grouping and its arrangement are the task's own, and what the two share is the
    metrics rather than the machinery. So the seam stays where it is, and this list is drawn like
    the calendar's and People's.
  -->

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mailbox.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mailbox.Controls.Common\Mailbox.Controls.Common.csproj" />
    <ProjectReference Include="..\Mailbox.Core\Mailbox.Core.csproj" />
    <ProjectReference Include="..\Mailbox.Scheduling\Mailbox.Scheduling.csproj" />
    <ProjectReference Include="..\Mailbox.Theming\Mailbox.Theming.csproj" />
  </ItemGroup>

</Project>
