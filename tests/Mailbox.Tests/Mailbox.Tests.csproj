<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="$(SqliteVersion)" />
    <PackageReference Include="SQLite3MC.PCLRaw.bundle" Version="$(SqliteCiphersVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(TestSdkVersion)" />
    <PackageReference Include="xunit.v3" Version="$(XunitVersion)" />
    <PackageReference Include="xunit.runner.visualstudio" Version="$(XunitRunnerVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mailbox.Core\Mailbox.Core.csproj" />
    <ProjectReference Include="..\..\src\Mailbox.Theming\Mailbox.Theming.csproj" />
    <ProjectReference Include="..\..\src\Mailbox.Store\Mailbox.Store.csproj" />
    <ProjectReference Include="..\..\src\Mailbox.Junk\Mailbox.Junk.csproj" />
    <ProjectReference Include="..\..\src\Mailbox.Protocols\Mailbox.Protocols.csproj" />
    <ProjectReference Include="..\..\src\Mailbox.Rendering\Mailbox.Rendering.csproj" />
    <ProjectReference Include="..\..\src\Mailbox.Security\Mailbox.Security.csproj" />
    <ProjectReference Include="..\..\src\Mailbox.Editor\Mailbox.Editor.csproj" />
    <ProjectReference Include="..\..\src\Mailbox.Contacts\Mailbox.Contacts.csproj" />
    <ProjectReference Include="..\..\src\Mailbox.Controls.Calendar\Mailbox.Controls.Calendar.csproj" />
    <ProjectReference Include="..\..\src\Mailbox.Controls.Journal\Mailbox.Controls.Journal.csproj" />
    <ProjectReference Include="..\..\src\Mailbox.Controls.Notes\Mailbox.Controls.Notes.csproj" />
    <ProjectReference Include="..\..\src\Mailbox.Controls.People\Mailbox.Controls.People.csproj" />
    <ProjectReference Include="..\..\src\Mailbox.Controls.Ribbon\Mailbox.Controls.Ribbon.csproj" />
    <ProjectReference Include="..\..\src\Mailbox.Controls.Tasks\Mailbox.Controls.Tasks.csproj" />
    <ProjectReference Include="..\..\src\Mailbox.Dav\Mailbox.Dav.csproj" />
    <ProjectReference Include="..\..\src\Mailbox.Google\Mailbox.Google.csproj" />
    <ProjectReference Include="..\..\src\Mailbox.Scheduling\Mailbox.Scheduling.csproj" />
    <ProjectReference Include="..\..\src\Mailbox.Plugins\Mailbox.Plugins.csproj" />
    <ProjectReference Include="..\..\src\Mailbox.Import\Mailbox.Import.csproj" />
    <ProjectReference Include="..\..\src\Mailbox.Pst\Mailbox.Pst.csproj" />

    <!-- The plugin the host tests stage into scratch directories: a file in the output, never a
         reference, so it reaches the tests only through the real loader. -->
    <ProjectReference Include="..\Mailbox.TestPlugin\Mailbox.TestPlugin.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
